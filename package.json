{
  "name": "holyshit-tv-site",
  "private": true,
  "version": "1.0.0",
  "description": "HolyShit.TV — asset teaser site (static, Tailwind)",
  "scripts": {
    "build": "tailwindcss -i input.css -o assets/tailwind.css --minify --content \"./index.html\"",
    "watch": "tailwindcss -i input.css -o assets/tailwind.css --watch --content \"./index.html\"",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": { "tailwindcss": "^3.4.17" }
}
